# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lumina
POSTGRES_USER=lumina
POSTGRES_PASSWORD=changeme

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# Application
APP_ENV=development
SECRET_KEY=your-secret-key-change-in-production
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# LiteLLM
LITELLM_MASTER_KEY=
LITELLM_LOG_LEVEL=INFO

# Features
ENABLE_MEMORY=true
ENABLE_REFLECTION=true
ENABLE_TOKEN_OPTIMIZATION=true
MAX_PARALLEL_AGENTS=5
